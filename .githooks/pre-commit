#!/bin/sh
# Refuse to commit the MCP edge function as the stub a local build produces.
#
# supabase/functions/mcp/index.ts is generated by mcpPlugin() in vite.config.ts
# and rewritten on every `vite dev` / `vite build`. Outside Lovable's own
# environment the plugin cannot bundle and writes an 8-line entry stub that
# imports through an absolute path on the build machine. Deployed, that stub
# resolves to nothing and every MCP tool disappears from production.
#
# Enable once per clone:  git config core.hooksPath .githooks
# (npm install does this for you via the "prepare" script.)

f=supabase/functions/mcp/index.ts

git diff --cached --name-only | grep -qx "$f" || exit 0

staged=$(git show ":$f" 2>/dev/null)
lines=$(printf '%s' "$staged" | grep -c '')

if [ "$lines" -lt 100 ] || ! printf '%s' "$staged" | grep -q '// src/lib/mcp/tools/'; then
  echo "pre-commit: refusing to commit $f"
  echo
  echo "  It is $lines lines and has no inlined tool modules, so it is the stub a"
  echo "  local build writes, not the real bundle. Committing it removes every"
  echo "  tool from the deployed mcp function."
  echo
  echo "  Fix:  git restore --staged --worktree $f"
  echo "  Then commit again. Run 'npm test' to confirm."
  exit 1
fi
exit 0
