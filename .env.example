# AI Workstation Environment Variables
# Copy to .env and fill in your paths

# Root workspace directory containing AI_ Workspace
AI_WORKSPACE_ROOT=C:/Users/Eru/AI_ Workspace

# Permanent storage drive for models and memory vault
PERMANENT_STORAGE=E:/AI_Permanent

# LM Studio models directory
LM_STUDIO_MODELS=C:/Users/Eru/AI_ Workspace/models/LM_Studio/Models

# Optional: Override GPU memory utilization
GPU_MEMORY_UTILIZATION=0.92

# Optional: CPU threads for routing
CPU_THREADS=32
