{
  "name": "context-condenser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Context condensing engine with anchored dehydration and real rehydration.",
  "engines": { "node": ">=22.6" },
  "bin": {
    "cce": "./packages/cli/cce.ts",
    "cce-mcp": "./packages/mcp/server.ts"
  },
  "scripts": {
