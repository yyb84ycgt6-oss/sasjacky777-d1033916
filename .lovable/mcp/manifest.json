{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://iezgzdhhmwmbqshnxrie.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sas-jacky",
      "version": "0.2.0",
      "title": "SAS-JACKY"
    },
    "tools": [
      {
        "name": "ask_jackie",
        "title": "Ask Jackie",
        "description": "Send a message to Jackie and get her answer. She sees the user's memory and active tasks. The exchange is saved to a conversation in the app (a new one unless conversation_id is given).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "description": "What to say to Jackie."
            },
            "conversation_id": {
              "type": "string",
              "description": "Continue this conversation (its recent history is sent)."
            },
            "title": {
              "type": "string",
              "description": "Title for a new conversation."
            },
            "engine": {
              "type": "string",
              "enum": [
                "cloud",
                "deepseek",
                "bionic",
                "ollama"
              ],
              "description": "Which engine answers (default cloud). bionic and ollama answer the owner only."
            },
            "model": {
              "type": "string",
              "description": "Model id for that engine; omit for its default."
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List the signed-in user's Jackie tasks, newest first. Optionally filter by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done",
                "blocked"
              ],
              "description": "Filter by task status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a new Jackie task for the signed-in user. It appears on the app's task board.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Short task title."
            },
            "description": {
              "type": "string",
              "description": "Optional longer detail."
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done",
                "blocked"
              ],
              "description": "Column to start in (default todo)."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "description": "Priority (default medium)."
            },
            "category": {
              "type": "string",
              "description": "Optional grouping category."
            },
            "due_date": {
              "type": "string",
              "description": "Optional ISO 8601 due date."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_task",
        "title": "Update task",
        "description": "Change any of a task's status, priority, title, description or due date. Give only the fields to change.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Task id (uuid)."
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done",
                "blocked"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "due_date": {
              "type": "string",
              "description": "ISO 8601 date, or empty string to clear it."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_task_status",
        "title": "Update task status",
        "description": "Change the status of one of the signed-in user's Jackie tasks.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Task id (uuid)."
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done",
                "blocked"
              ],
              "description": "New status."
            }
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_task",
        "title": "Delete task",
        "description": "Permanently delete one of the signed-in user's tasks. Prefer update_task with status done to finish a task.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Task id (uuid)."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_memory",
        "title": "Search Jackie memory",
        "description": "Search the signed-in user's Jackie long-term memory by key or value text. Omit query to list recent entries.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Text to match against memory key or value."
            },
            "category": {
              "type": "string",
              "enum": [
                "preference",
                "decision",
                "context",
                "pattern",
                "architecture",
                "style"
              ],
              "description": "Optional category filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "remember_fact",
        "title": "Remember a fact",
        "description": "Store or overwrite a fact in the signed-in user's Jackie long-term memory. Jackie sees it in every chat.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "description": "Stable identifier for the fact."
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "description": "The fact to remember."
            },
            "category": {
              "type": "string",
              "enum": [
                "preference",
                "decision",
                "context",
                "pattern",
                "architecture",
                "style"
              ],
              "description": "Category (default context)."
            }
          },
          "required": [
            "key",
            "value"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "forget_fact",
        "title": "Forget a fact",
        "description": "Delete one of Jackie's memory entries, by id or by key.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Memory entry id (uuid)."
            },
            "key": {
              "type": "string",
              "description": "Memory key, when the id is not known."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_conversations",
        "title": "List conversations",
        "description": "List the signed-in user's Jackie chat conversations, most recently updated first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "read_conversation",
        "title": "Read conversation",
        "description": "Read the most recent messages of one conversation, oldest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Conversation id (uuid), from list_conversations."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "How many recent messages (default 40)."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_conversation",
        "title": "Create conversation",
        "description": "Start a new conversation in the app's chat sidebar. Use its id with ask_jackie.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Conversation title (default 'Agent session')."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
